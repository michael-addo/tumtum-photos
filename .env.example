# Optional: the server reads these straight from the environment.
# Copy to .env and load it with:  tsx --env-file=.env server/index.ts

PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Required to use /admin and GET /api/admin/enquiries.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Set to 1 only when running behind a reverse proxy you control
# (otherwise clients can spoof X-Forwarded-For and dodge rate limits).
TRUST_PROXY=0
